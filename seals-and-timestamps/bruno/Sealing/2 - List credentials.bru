meta {
  name: 2. List credentials
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/csc/v2/credentials/list
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{accessToken}}
}

body:json {
  {
    "credentialInfo": true,
    "certificates": "chain"
  }
}

script:post-response {
  bru.setVar('credentialId', res.body.credentialIDs[0]);
}
