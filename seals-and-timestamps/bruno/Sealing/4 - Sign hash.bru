meta {
  name: 4. Sign hash
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/csc/v2/signatures/signHash
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{accessToken}}
}

body:json {
  {
    "credentialID": "{{credentialId}}",
    "SAD": "{{sad}}",
    "hashes": ["{{sealingHash}}"],
    "hashAlgorithmOID": "2.16.840.1.101.3.4.2.3",
    "signAlgo": "1.2.840.113549.1.1.10",
    "signAlgoParams": "{{signAlgoParams}}"
  }
}
