meta {
  name: 1. Info
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/csc/v2/info
  body: json
  auth: none
}

body:json {
  {}
}

script:post-response {
  const signAlgorithms = res.body.signAlgorithms;
  const index = signAlgorithms.algos.indexOf('1.2.840.113549.1.1.10');
  bru.setVar('signAlgoParams', signAlgorithms.algoParams[index]);
}
