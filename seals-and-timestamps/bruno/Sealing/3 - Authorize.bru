meta {
  name: 3. Authorize
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/csc/v2/credentials/authorize
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{accessToken}}
}

body:json {
  {
    "credentialID": "{{credentialId}}",
    "numSignatures": 1,
    "hashes": ["{{sealingHash}}"],
    "hashAlgorithmOID": "2.16.840.1.101.3.4.2.3",
    "authData": [{"id": "PIN", "value": "{{pin}}"}]
  }
}

script:post-response {
  bru.setVar('sad', res.body.SAD);
}
